APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Produção — checklist mínimo (descomente e ajuste no servidor)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://www.cambioautomaticodobrasil.com.br
# CACHE_STORE=redis
# PREVIEW_ROUTES_ENABLED=false
#
# APP_URL alimenta canonical, og:url, robots.txt e sitemap.xml.
# Nunca deixe http://localhost em produção.
#
# Após alterar variáveis de ambiente, rode no deploy:
#   php artisan config:clear
#   php artisan cache:clear
#   php artisan config:cache
#   php artisan route:cache
#   php artisan view:cache
#   php artisan migrate --force   (se SESSION_DRIVER=database)
#   php artisan queue:work --tries=5   (processar formulários em fila)
#   php artisan schedule:run             (cron: * * * * * no servidor)

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção HTTPS: SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = processa na hora (dev). database/redis = requer `php artisan queue:work`.
QUEUE_CONNECTION=database
# Produção: prefira redis se já estiver disponível.
# QUEUE_CONNECTION=redis
#
# Desenvolvimento local do scheduler: php artisan schedule:work

# file evita "database is locked" quando DB_CONNECTION=sqlite (cache + throttle + sessão no mesmo arquivo).
CACHE_STORE=file
# Produção com Redis: use redis para cache da API CAB e melhor throughput.
# CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# CAB API — integração com o back-end do portal
# ---------------------------------------------------------------------------

# Em produção use true; após alterar rode: php artisan config:clear
CAB_API_ENABLED=true
CAB_API_BASE_URL=https://crm.cambioautomaticodobrasil.com.br/api/site/
CAB_PLANS_SIGNUP_URL=https://crm.cambioautomaticodobrasil.com.br/cadastro
CAB_API_VERSION=v1
CAB_API_TIMEOUT=30
CAB_API_CACHE_TTL=600
CAB_SITEMAP_CACHE_TTL=3600

# Funcionalidades do site
OFICINAS_ENABLED=true
PREVIEW_ROUTES_ENABLED=false
BLOG_COLUMNISTS_ENABLED=false

# Google Tag Manager (deixe vazio para desabilitar no ambiente local)
GOOGLE_TAG_MANAGER_ID=GTM-N3W9TK6

# Créditos do rodapé (by PDS and t4v)
SITE_CREDIT_PDS_URL=https://paradigmadesign.com.br/
SITE_CREDIT_T4V_URL=https://github.com/otavio-htc

# Cache de mocks locais (Academia) até API dedicada
CAB_ACADEMY_MOCK_CACHE_TTL=3600

# Blog
CAB_API_BLOG_POSTS=blog/materias
CAB_API_BLOG_CATEGORIES=blog/categorias
CAB_API_BLOG_COLUMNISTS=blog/colunistas
CAB_API_BLOG_CATEGORY_FILTER=blog/materias?category_id={category_id}
CAB_API_BLOG_COLUMNIST_FILTER=blog/materias?columnist_id={columnist_id}
# Capas do blog (a API pode retornar URLs do HML; mídias como eventos .webp ficam no CRM)
CAB_API_BLOG_MEDIA_BASE_URL=https://crm.cambioautomaticodobrasil.com.br
# Proxy de mídia: mascara URLs do CRM no HTML (/media/{token})
# CAB_MEDIA_PROXY_ENABLED=true
# CAB_MEDIA_PROXY_ALLOWED_HOSTS=crm.cambioautomaticodobrasil.com.br,hml.cambioautomaticodobrasil.com.br
# Imagem padrão de compartilhamento (Open Graph / Twitter)
# CAB_DEFAULT_OG_IMAGE=/images/carousel/cab_carousel_1.webp
# Content-Security-Policy ampliado (true recomendado em produção)
# CAB_CSP_ENABLED=true
# Logos de parceiros (caminhos relativos da API → /storage/patrocinadores/... no CRM)
# CAB_API_SPONSORS_MEDIA_BASE_URL=https://crm.cambioautomaticodobrasil.com.br
# CAB_API_SPONSORS_MEDIA_PATH_PREFIX=storage

# Planos / cursos
CAB_API_COURSES=https://crm.cambioautomaticodobrasil.com.br/api/site/courses
CAB_API_PLANS=https://crm.cambioautomaticodobrasil.com.br/api/site/plans

# Eventos (agenda CAB)
CAB_API_EVENTS=https://crm.cambioautomaticodobrasil.com.br/api/site/eventos
CAB_API_HOTSITES=https://crm.cambioautomaticodobrasil.com.br/api/site/hotsites
CAB_API_PLATFORM_MATERIALS=https://crm.cambioautomaticodobrasil.com.br/api/site/materiais
# URL de inscrição/ingressos. Use {slug}, {lp_slug} ou {id} como placeholders.
# Padrão: landing page do evento em lp.cambioautomaticodobrasil.com.br
CAB_EVENTS_TICKET_URL=https://lp.cambioautomaticodobrasil.com.br/{lp_slug}

# Home / newsletter (POST nome, email, telefone?, tipo — GERAL, BLOG, DICAS, etc.)
CAB_API_NEWSLETTER=https://crm.cambioautomaticodobrasil.com.br/api/newsletter
CAB_API_HOME_CTA=https://crm.cambioautomaticodobrasil.com.br/api/newsletter
# CAB_API_NEWSLETTER_FIELD_NAME=nome
# CAB_API_NEWSLETTER_FIELD_EMAIL=email
# CAB_API_NEWSLETTER_FIELD_PHONE=telefone
# CAB_API_NEWSLETTER_FIELD_TYPE=tipo

# Parceria CAB + Raven (/cabraven)
# POST JSON (tipo_documento, documento, nome, email, whatsapp). O CRM responde se é assinante ativo
# ou cria o lead. Vazio (ou sem token) = todos vão para o WhatsApp.
CAB_API_CABRAVEN=https://crm.cambioautomaticodobrasil.com.br/api/v1/site/cabraven
# Token das chamadas ao CRM (Authorization: Bearer). Mesma variável e mesmo valor no .env do CRM.
CAB_API_SITE_TOKEN=
# CAB_RAVEN_WHATSAPP=5519971659055
# Consulta de CNPJ (Receita Federal) para preencher a razão social. {cnpj} = só dígitos.
# CAB_RAVEN_CNPJ_LOOKUP_URL=https://brasilapi.com.br/api/cnpj/v1/{cnpj}
# CAB_RAVEN_CNPJ_LOOKUP_FALLBACK_URL=https://receitaws.com.br/v1/cnpj/{cnpj}

# Suporte — formulário de contato (POST nome, email, telefone?, assunto, mensagem)
CAB_API_SUPPORT_CONTACT=https://crm.cambioautomaticodobrasil.com.br/api/contato
# CAB_API_SUPPORT_CONTACT_FIELD_NAME=nome
# CAB_API_SUPPORT_CONTACT_FIELD_EMAIL=email
# CAB_API_SUPPORT_CONTACT_FIELD_PHONE=telefone
# CAB_API_SUPPORT_CONTACT_FIELD_SUBJECT=assunto
# CAB_API_SUPPORT_CONTACT_FIELD_MESSAGE=mensagem

# Documentos legais (opcional — valores padrão em config/site/company.php)
# LEGAL_COMPANY_CNPJ=32.116.961/0001-52
# LEGAL_CONTACT_EMAIL=contato@cambioautomaticodobrasil.com.br
# LEGAL_DPO_EMAIL=privacidade@cambioautomaticodobrasil.com.br

# Demais endpoints (workshops, partners, plans, banners, popups) serão
# configurados conforme a integração for concluída.

# ---------------------------------------------------------------------------
# Observabilidade CAB
# ---------------------------------------------------------------------------
# Logs estruturados da API: storage/logs/cab-api.log (canal `cab`)
# CAB_LOG_LEVEL=warning
# CAB_LOG_DAILY_DAYS=14
#
# Health check estendido: GET /health (além do /up do Laravel)
# CAB_HEALTH_PING_ENABLED=false
# CAB_HEALTH_PING_TIMEOUT=5
# CAB_HEALTH_PING_ENDPOINT=blog/categorias
#
# Monitoramento externo (opcional): integre Sentry/Bugsnag via LOG_CHANNEL
# ou pacote dedicado quando for para produção.
